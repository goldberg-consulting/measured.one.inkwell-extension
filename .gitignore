out/
node_modules/
*.vsix
.vscode-test/
examples/venv/
# Stray nested .inkwell only (workspace root .inkwell/ is the real project)
examples/.inkwell/
examples/*.pdf
# Tracked under root .inkwell/: manifest.json, scripts/, references/, figures/.gitkeep
# Everything else under .inkwell/ is generated at runtime
.inkwell/outputs/
.inkwell/runs/
.inkwell/compiled/
.inkwell/mermaid/
.inkwell/figures/*.pdf
.inkwell/guide.md
.inkwell/examples/
.inkwell/templates/
.inkwell/.cache/
demo-project/
# Local demo/test documents should not be committed
demo.md
demo.pdf
*.aux
*.log
*.out
*.fls
*.fdb_latexmk
*.synctex.gz
__pycache__/
*.pyc
venv/
.venv/
.inkwell/compiled.*

# Rebuilt deterministically from pinned preview dependencies
media/preview-client.js
media/vendor/

# Client deliverables stay in separate workspaces, never in commits or releases.
**/*proposal*.md
**/*proposal*.pdf
**/*proposal*.docx
**/*qualifications*.md
**/*qualifications*.pdf
**/*qualifications*.docx
**/private/**
**/confidential/**
**/client-documents/**
