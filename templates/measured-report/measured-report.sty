\newcommand{\MeasuredCover}{%
\begin{tikzpicture}[remember picture,overlay,x=1in,y=1in]
\begin{scope}[shift={(current page.south west)}]
\fill[MeasuredInk] (0,0) rectangle (8.5,11);
% Signal field: original contour-like curves, not a representation of client data.
\clip (0,2.9) rectangle (8.5,6.4);
\foreach \i in {0,...,28}{
  \draw[MeasuredTeal!70!MeasuredLime,opacity=0.45,line width=0.5pt]
    plot[domain=-1:10,samples=100,smooth] (\x,{3.1+0.095*\i+0.42*sin(35*\x+5*\i)+0.30*cos(58*\x-3*\i)});
}
\draw[MeasuredLime,line width=1.4pt] plot[domain=-1:10,samples=100,smooth]
  (\x,{4.25+0.42*sin(35*\x+55)+0.30*cos(58*\x-33)});
\end{scope}
\end{tikzpicture}}
